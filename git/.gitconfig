# Name/email live in ~/.gitconfig.local (written by install.sh, not in the repo)
[include]
	path = ~/.gitconfig.local
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[diff]
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[core]
	editor = vi
